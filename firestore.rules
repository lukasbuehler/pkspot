rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth.uid != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    function spotReportPrivacyMigrationComplete() {
      let statePath = /databases/$(database)/documents/maintenance/spot-report-privacy;
      return exists(statePath) && get(statePath).data.completed == true;
    }

    function isOrganizationReviewer(organizationId) {
      return request.auth.uid != null
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'reviewer'];
    }

    function isOrganizationManager(organizationId) {
      return request.auth.uid != null
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    function isOrganizationMember(organizationId) {
      return request.auth.uid != null
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'reviewer', 'member'];
    }

    function isMutualFriend(userId) {
      return request.auth.uid != null
        && request.auth.uid != userId
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/followers/$(userId));
    }

    function canReadLogEntry(userId, entryData) {
      return (request.auth != null && request.auth.uid == userId)
        || entryData.visibility == 'public'
        || (
          request.auth.uid != null
          && entryData.visibility == 'followers'
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId))
        )
        || (
          entryData.visibility == 'friends'
          && isMutualFriend(userId)
        );
    }

    function validLogEntry(userId) {
      return request.resource.data.keys().hasAll([
          'owner_id',
          'note',
          'visibility',
          'session_record_ids',
          'session_summaries',
          'activity_at',
          'activity_at_raw_ms',
          'time_created',
          'time_created_raw_ms',
          'time_updated',
          'time_updated_raw_ms'
        ])
        && request.resource.data.owner_id == userId
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 10000
        && request.resource.data.visibility in [
          'private',
          'friends',
          'followers',
          'public'
        ]
        && request.resource.data.session_record_ids is list
        && request.resource.data.session_record_ids.size() > 0
        && request.resource.data.session_record_ids.size() <= 20
        && request.resource.data.session_summaries is list
        && request.resource.data.session_summaries.size()
          == request.resource.data.session_record_ids.size()
        && request.resource.data.activity_at is timestamp
        && request.resource.data.activity_at_raw_ms is number
        && request.resource.data.time_created is timestamp
        && request.resource.data.time_created_raw_ms is number
        && request.resource.data.time_updated is timestamp
        && request.resource.data.time_updated_raw_ms is number;
    }

    function canReadSpotEdit() {
      return !('visibility' in resource.data)
        || resource.data.visibility != 'private'
        || (request.auth.uid != null && request.auth.uid == resource.data.user.uid)
        || isAdmin()
        || (
          'review_organization_id' in resource.data
          && isOrganizationReviewer(resource.data.review_organization_id)
        );
    }

    function requiresOrganizationReview(spotId) {
      let spot = get(/databases/$(database)/documents/spots/$(spotId)).data;
      return ('management' in spot && spot.management.status == 'managed')
        || (
          'stewardship' in spot
          && 'organization_ids' in spot.stewardship
          && spot.stewardship.organization_ids.size() > 0
        );
    }

    function eventComputedFields() {
      return [
        'description',
        'start_seconds',
        'end_seconds',
        'promo_starts_at_seconds',
        'location',
        'bounds',
        'bounds_center',
        'bounds_radius_m',
        'promo_region_center',
        'promo_region_radius_m',
        'has_organization',
        'has_venue_spot',
        'venue_spot_count',
        'rsvp_counts'
      ];
    }

    function eventPlatformControlledFields() {
      return [
        'priority',
        'is_promoted',
        'is_sponsored',
        'promo_starts_at',
        'promo_region',
        'promo_radius_m'
      ];
    }

    function validEventOwner(owner) {
      return owner is map
        && (
          (
            owner.type == 'user'
            && owner.keys().hasOnly(['type', 'user_id'])
            && owner.user_id is string
            && owner.user_id.size() > 0
          )
          || (
            owner.type == 'organization'
            && owner.keys().hasOnly(['type', 'organization_id'])
            && owner.organization_id is string
            && owner.organization_id.size() > 0
          )
        );
    }

    function validEventCreator(creator) {
      return creator is map
        && creator.keys().hasAll(['uid'])
        && creator.keys().hasOnly(['uid', 'username'])
        && creator.uid == request.auth.uid
        && (!('username' in creator) || creator.username is string);
    }

    function validEventAuditTimestamps(eventData) {
      return (
          !('time_created' in eventData)
          || eventData.time_created is timestamp
        )
        && (
          !('time_updated' in eventData)
          || eventData.time_updated is timestamp
        );
    }

    function eventIsPublished(eventData) {
      return (
          'publication_state' in eventData
          && eventData.publication_state == 'published'
        )
        || (
          !('publication_state' in eventData)
          && eventData.get('published', true) == true
        );
    }

    function eventHasAccessRole(eventId, roles) {
      return request.auth.uid != null
        && exists(/databases/$(database)/documents/events/$(eventId)/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/events/$(eventId)/access/$(request.auth.uid)).data.role in roles;
    }

    function eventIsOwnedByViewer(eventData) {
      return request.auth.uid != null
        && 'owner' in eventData
        && eventData.owner is map
        && eventData.owner.type == 'user'
        && eventData.owner.user_id == request.auth.uid;
    }

    function eventIsManagedByViewerOrganization(eventData) {
      return 'owner' in eventData
        && eventData.owner is map
        && eventData.owner.type == 'organization'
        && isOrganizationManager(eventData.owner.organization_id);
    }

    function eventCanManage(eventData) {
      return isAdmin()
        || eventIsOwnedByViewer(eventData)
        || eventIsManagedByViewerOrganization(eventData);
    }

    function eventCanEdit(eventId, eventData) {
      return isAdmin()
        || (
          'owner' in eventData
          && eventData.owner is map
          && (
            eventCanManage(eventData)
            || eventHasAccessRole(eventId, ['collaborator'])
          )
        );
    }

    function eventPrivateAudienceAllowsViewer(eventData) {
      return 'viewer_policy' in eventData
        && eventData.viewer_policy is map
        && eventData.viewer_policy.audience == 'organization_members'
        && isOrganizationMember(eventData.viewer_policy.organization_id);
    }

    function eventCanRead(eventId, eventData) {
      return eventCanEdit(eventId, eventData)
        || (
          eventIsPublished(eventData)
          && (
            eventData.get('visibility', 'public') != 'private'
            || eventPrivateAudienceAllowsViewer(eventData)
            || eventHasAccessRole(eventId, ['viewer', 'collaborator'])
          )
        );
    }

    function validEventViewerPolicy(eventData) {
      return !('viewer_policy' in eventData)
        || (
          eventData.viewer_policy is map
          && (
            (
              eventData.viewer_policy.audience == 'invited'
              && eventData.viewer_policy.keys().hasOnly(['audience'])
            )
            || (
              eventData.viewer_policy.audience == 'organization_members'
              && eventData.viewer_policy.keys().hasOnly(['audience', 'organization_id'])
              && eventData.viewer_policy.organization_id is string
              && eventData.viewer_policy.organization_id.size() > 0
            )
          )
        );
    }

    function validEventDiscoverability(eventData) {
      return !('discoverability' in eventData)
        || (
          eventData.discoverability is map
          && eventData.discoverability.keys().hasAll(['audience'])
          && (
            (
              eventData.discoverability.audience in ['global', 'none']
              && eventData.discoverability.keys().hasOnly(['audience'])
            )
            || (
              eventData.discoverability.audience in [
                'organization_followers',
                'organization_members'
              ]
              && eventData.discoverability.keys().hasOnly([
                'audience',
                'organization_id'
              ])
              && eventData.discoverability.organization_id is string
              && eventData.discoverability.organization_id.size() > 0
            )
          )
        );
    }

    function validEventAttendanceEligibility(attendance) {
      return !('eligibility' in attendance)
        || (
          attendance.eligibility is map
          && attendance.eligibility.keys().hasAll(['type'])
          && (
            (
              attendance.eligibility.type in ['everyone', 'invited']
              && attendance.eligibility.keys().hasOnly(['type'])
            )
            || (
              attendance.eligibility.type == 'organization_members'
              && attendance.eligibility.keys().hasOnly([
                'type',
                'organization_id'
              ])
              && attendance.eligibility.organization_id is string
              && attendance.eligibility.organization_id.size() > 0
            )
          )
        );
    }

    function validEventAttendance(eventData) {
      return !('attendance' in eventData)
        || (
          eventData.attendance is map
          && eventData.attendance.keys().hasAll(['social', 'admission'])
          && eventData.attendance.keys().hasOnly([
            'social',
            'admission',
            'capacity',
            'waitlist',
            'eligibility'
          ])
          && eventData.attendance.social in ['none', 'rsvp']
          && eventData.attendance.admission in ['none', 'registration']
          && (
            !('capacity' in eventData.attendance)
            || (
              eventData.attendance.admission == 'registration'
              && eventData.attendance.capacity is int
              && eventData.attendance.capacity > 0
            )
          )
          && (
            !('waitlist' in eventData.attendance)
            || (
              eventData.attendance.admission == 'registration'
              && eventData.attendance.waitlist is bool
            )
          )
          && validEventAttendanceEligibility(eventData.attendance)
        );
    }

    function validEventAccessDimensions(eventData) {
      return eventData.get('visibility', 'public') in ['public', 'unlisted', 'private']
        && validEventDiscoverability(eventData)
        && validEventViewerPolicy(eventData)
        && validEventAttendance(eventData);
    }

    // Temporary rollout switch. While true, old app versions may still list
    // /events directly, so new writes must remain globally public.
    function legacyEventListCompatibilityEnabled() {
      return true;
    }

    function eventIsLegacyListCompatible(eventData) {
      return eventData.get('visibility', 'public') == 'public'
        && (
          !('discoverability' in eventData)
          || (
            eventData.discoverability is map
            && eventData.discoverability.audience == 'global'
          )
        );
    }

    function eventOwnerMayBeAssignedByViewer(owner) {
      return (
          owner.type == 'user'
          && owner.user_id == request.auth.uid
        )
        || (
          owner.type == 'organization'
          && isOrganizationManager(owner.organization_id)
        );
    }

    function eventPolicyOrganizationsManagedByViewer(eventData) {
      return (
          !('discoverability' in eventData)
          || !(eventData.discoverability.audience in [
            'organization_followers',
            'organization_members'
          ])
          || isOrganizationManager(eventData.discoverability.organization_id)
        )
        && (
          !('viewer_policy' in eventData)
          || eventData.viewer_policy.audience != 'organization_members'
          || isOrganizationManager(eventData.viewer_policy.organization_id)
        )
        && (
          !('attendance' in eventData)
          || !('eligibility' in eventData.attendance)
          || eventData.attendance.eligibility.type != 'organization_members'
          || isOrganizationManager(
            eventData.attendance.eligibility.organization_id
          )
        );
    }

    function eventOrganizationPoliciesUnchanged(before, after) {
      return before.get('discoverability', {}) == after.get('discoverability', {})
        && before.get('viewer_policy', {}) == after.get('viewer_policy', {})
        && before.get('attendance', {}).get('eligibility', {})
          == after.get('attendance', {}).get('eligibility', {});
    }

    function validEventAccessGrant(userId) {
      return request.resource.data.keys().hasAll([
          'user_id',
          'role',
          'granted_by',
          'time_created',
          'time_updated'
        ])
        && request.resource.data.keys().hasOnly([
          'user_id',
          'role',
          'granted_by',
          'time_created',
          'time_updated'
        ])
        && request.resource.data.user_id == userId
        && request.resource.data.role in ['viewer', 'collaborator']
        && request.resource.data.granted_by is string
        && request.resource.data.time_created is timestamp
        && request.resource.data.time_updated is timestamp;
    }

    function validEventRsvp(eventId, userId) {
      return request.resource.data.keys().hasOnly([
          'user_id',
          'event_id',
          'rsvp',
          'time_created',
          'time_updated'
        ])
        && request.resource.data.user_id == userId
        && request.resource.data.event_id == eventId
        && request.resource.data.rsvp in ['going', 'interested', 'notgoing']
        && request.resource.data.time_updated is timestamp
        && (
          !('time_created' in request.resource.data)
          || request.resource.data.time_created is timestamp
        );
    }

    function validEventLiveUpdateSubscription(userId) {
      return request.resource.data.keys().hasAll([
          'user_id',
          'active',
          'subscribed_at',
          'updated_at'
        ])
        && request.resource.data.keys().hasOnly([
          'user_id',
          'active',
          'event_reminders',
          'subscribed_at',
          'updated_at'
        ])
        && request.resource.data.user_id == userId
        && request.resource.data.active is bool
        && (!('event_reminders' in request.resource.data)
          || request.resource.data.event_reminders is bool)
        && request.resource.data.subscribed_at is timestamp
        && request.resource.data.updated_at is timestamp;
    }

    function eventAcceptsLiveUpdateSubscriptions(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return eventCanRead(eventId, event)
        && eventIsPublished(event)
        && event.end is timestamp
        && event.end >= request.time
        && event.get('notification_policy', 'all') != 'none';
    }

    function validCommunityKnowledgeEdit(communityKey) {
      return request.resource.data.keys().hasAll([
          'target_type',
          'target_id',
          'schema_version',
          'type',
          'edit_kind',
          'operation',
          'data',
          'status',
          'approved',
          'visibility',
          'review_policy',
          'user',
          'timestamp',
          'timestamp_raw_ms'
        ])
        && request.resource.data.keys().hasOnly([
          'target_type',
          'target_id',
          'schema_version',
          'type',
          'edit_kind',
          'operation',
          'data',
          'status',
          'approved',
          'visibility',
          'review_policy',
          'user',
          'timestamp',
          'timestamp_raw_ms',
          'community_display_name',
          'community_path'
        ])
        && request.resource.data.target_type == 'community'
        && request.resource.data.target_id == communityKey
        && request.resource.data.schema_version == 1
        && request.resource.data.type == 'UPDATE'
        && request.resource.data.edit_kind == 'knowledge'
        && request.resource.data.operation == 'UPSERT_KNOWLEDGE_CARD'
        && request.resource.data.data is map
        && request.resource.data.data.keys().hasOnly(['card'])
        && request.resource.data.data.card is map
        && request.resource.data.status == 'pending'
        && request.resource.data.approved == false
        && request.resource.data.visibility == 'private'
        && request.resource.data.review_policy == 'admin'
        && validReportUserReference(request.resource.data.user)
        && request.resource.data.user.uid == request.auth.uid
        && request.resource.data.timestamp is timestamp
        && request.resource.data.timestamp_raw_ms is number
        && (!('community_display_name' in request.resource.data)
          || request.resource.data.community_display_name is string)
        && (!('community_path' in request.resource.data)
          || request.resource.data.community_path is string);
    }

    function validContactUser() {
      return !('user' in request.resource.data)
        || (
          request.auth.uid != null
          && request.resource.data.user is map
          && request.resource.data.user.keys().hasOnly([
            'uid',
            'email',
            'display_name'
          ])
          && request.resource.data.user.keys().hasAll(['uid'])
          && request.resource.data.user.uid == request.auth.uid
          && (!('email' in request.resource.data.user) || request.resource.data.user.email is string)
          && (!('display_name' in request.resource.data.user) || request.resource.data.user.display_name is string)
        );
    }

    function validContactAnalytics() {
      return !('analytics' in request.resource.data)
        || (
          request.resource.data.analytics is map
          && request.resource.data.analytics.keys().hasOnly([
            'posthog_distinct_id',
            'posthog_session_id',
            'posthog_session_replay_url'
          ])
          && (!('posthog_distinct_id' in request.resource.data.analytics) || (
            request.resource.data.analytics.posthog_distinct_id is string
            && request.resource.data.analytics.posthog_distinct_id.size() <= 200
          ))
          && (!('posthog_session_id' in request.resource.data.analytics) || (
            request.resource.data.analytics.posthog_session_id is string
            && request.resource.data.analytics.posthog_session_id.size() <= 200
          ))
          && (!('posthog_session_replay_url' in request.resource.data.analytics) || (
            request.resource.data.analytics.posthog_session_replay_url is string
            && request.resource.data.analytics.posthog_session_replay_url.size() <= 500
          ))
        );
    }

    function validContactMessage() {
      return request.resource.data.keys().hasAll([
          'message',
          'contact_info',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'message',
          'contact_info',
          'user',
          'auth_email',
          'topic',
          'analytics',
          'locale',
          'source_path',
          'user_agent',
          'createdAt'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 4000
        && request.resource.data.contact_info is string
        && request.resource.data.contact_info.size() >= 1
        && request.resource.data.contact_info.size() <= 240
        && request.resource.data.createdAt is timestamp
        && (!('auth_email' in request.resource.data) || (
          request.auth.uid != null
          && request.resource.data.auth_email is string
        ))
        && (!('topic' in request.resource.data) || request.resource.data.topic in ['general', 'spot-import', 'crew'])
        && (!('locale' in request.resource.data) || request.resource.data.locale is string)
        && (!('source_path' in request.resource.data) || (
          request.resource.data.source_path is string
          && request.resource.data.source_path.size() <= 500
        ))
        && (!('user_agent' in request.resource.data) || (
          request.resource.data.user_agent is string
          && request.resource.data.user_agent.size() <= 500
        ))
        && validContactUser()
        && validContactAnalytics();
    }

    function validUserSocials() {
      return !('socials' in request.resource.data)
        || (
          request.resource.data.socials is map
          && request.resource.data.socials.keys().hasOnly([
            'instagram_handle',
            'youtube_handle',
            'tiktok_handle',
            'discord_url',
            'other'
          ])
          && (!('instagram_handle' in request.resource.data.socials) || (
            request.resource.data.socials.instagram_handle is string
            && request.resource.data.socials.instagram_handle.size() <= 120
          ))
          && (!('youtube_handle' in request.resource.data.socials) || (
            request.resource.data.socials.youtube_handle is string
            && request.resource.data.socials.youtube_handle.size() <= 160
          ))
          && (!('tiktok_handle' in request.resource.data.socials) || (
            request.resource.data.socials.tiktok_handle is string
            && request.resource.data.socials.tiktok_handle.size() <= 120
          ))
          && (!('discord_url' in request.resource.data.socials) || (
            request.resource.data.socials.discord_url is string
            && request.resource.data.socials.discord_url.size() <= 500
          ))
        );
    }

    function validUserProfileAccess() {
      return (!('account_privacy' in request.resource.data)
          || request.resource.data.account_privacy in ['public', 'private'])
        && (!('profile_visibility' in request.resource.data)
          || request.resource.data.profile_visibility in ['public', 'followers', 'mutuals'])
        && (
          request.resource.data.get('account_privacy', 'public') != 'private'
          || request.resource.data.get('profile_visibility', 'followers') != 'public'
        );
    }

    function validFollowRequest(userId, requesterId) {
      return request.resource.data.keys().hasOnly([
          'display_name',
          'profile_picture',
          'requested_at',
          'requested_at_raw_ms'
        ])
        && requesterId != userId
        && get(/databases/$(database)/documents/users/$(userId)).data.get('account_privacy', 'public') == 'private'
        && (!('display_name' in request.resource.data) || (
          request.resource.data.display_name is string
          && request.resource.data.display_name.size() <= 120
        ))
        && (!('profile_picture' in request.resource.data) || (
          request.resource.data.profile_picture is string
          && request.resource.data.profile_picture.size() <= 500
        ))
        && (!('requested_at' in request.resource.data) || request.resource.data.requested_at is timestamp)
        && (!('requested_at_raw_ms' in request.resource.data) || request.resource.data.requested_at_raw_ms is number);
    }

    function canApproveFollowRequest(userId, requesterId) {
      return request.auth.uid != null
        && request.auth.uid == userId
        && request.auth.uid != requesterId
        && exists(/databases/$(database)/documents/users/$(userId)/follow_requests/$(requesterId));
    }

    function validApprovedFollowingEdge(userId) {
      return request.resource.data.keys().hasOnly([
          'display_name',
          'profile_picture',
          'start_following',
          'start_following_raw_ms'
        ])
        && request.resource.data.display_name == get(/databases/$(database)/documents/users/$(userId)).data.display_name
        && (!('profile_picture' in request.resource.data) || (
          request.resource.data.profile_picture is string
          && request.resource.data.profile_picture.size() <= 500
        ))
        && (!('start_following' in request.resource.data) || request.resource.data.start_following is timestamp)
        && (!('start_following_raw_ms' in request.resource.data) || request.resource.data.start_following_raw_ms is number);
    }

    function validApprovedFollowerEdge(userId, requesterId) {
      return request.resource.data.keys().hasOnly([
          'display_name',
          'profile_picture',
          'start_following',
          'start_following_raw_ms'
        ])
        && request.resource.data.display_name == get(/databases/$(database)/documents/users/$(userId)/follow_requests/$(requesterId)).data.display_name
        && (!('profile_picture' in request.resource.data) || (
          request.resource.data.profile_picture is string
          && request.resource.data.profile_picture.size() <= 500
        ))
        && (!('start_following' in request.resource.data) || request.resource.data.start_following is timestamp)
        && (!('start_following_raw_ms' in request.resource.data) || request.resource.data.start_following_raw_ms is number);
    }

    function userCustomSocialLinksUnchanged() {
      return request.resource.data.get('socials', {}).get('other', []) ==
        resource.data.get('socials', {}).get('other', []);
    }

    function noUserCustomSocialLinksOnCreate() {
      return !('socials' in request.resource.data)
        || !('other' in request.resource.data.socials);
    }

    function agePolicyAllowsPublicParticipation() {
      return request.auth.uid != null
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('age_policy', {}).get('participation_state', 'allowed') in [
            'allowed',
            'platform_signal_unavailable'
          ]
        );
    }

    function userPublicParticipationFields() {
      return [
        'display_name',
        'biography',
        'profile_picture',
        'start_date',
        'start_date_raw_ms',
        'nationality_code',
        'home_city',
        'socials',
        'pinned_badges'
      ];
    }

    function homeSpotsUnchanged() {
      return request.resource.data.get('home_spots', null) ==
        resource.data.get('home_spots', null);
    }

    function validReportUserReference(userRef) {
      return userRef is map
        && userRef.keys().hasOnly([
          'uid',
          'display_name',
          'profile_picture'
        ])
        && userRef.keys().hasAll(['uid'])
        && userRef.uid is string
        && userRef.uid.size() > 0
        && userRef.uid.size() <= 128
        && (!('display_name' in userRef) || (
          userRef.display_name is string
          && userRef.display_name.size() <= 120
        ))
        && (!('profile_picture' in userRef) || (
          userRef.profile_picture is string
          && userRef.profile_picture.size() <= 500
        ));
    }

    function validModerationReportUser(userRef) {
      return userRef is map
        && userRef.keys().hasOnly([
          'uid',
          'email',
          'display_name',
          'profile_picture'
        ])
        && (
          (request.auth != null
            && 'uid' in userRef
            && userRef.uid is string
            && userRef.uid.size() > 0
            && userRef.uid.size() <= 128
            && userRef.uid == request.auth.uid
            && (!('email' in userRef) || (
              request.auth.token.email is string
              && userRef.email is string
              && userRef.email == request.auth.token.email
            )))
          || (request.auth == null
            && !('uid' in userRef)
            && 'email' in userRef
            && userRef.email is string
            && userRef.email.size() > 0
            && userRef.email.size() <= 240)
        )
        && (!('display_name' in userRef) || (
          userRef.display_name is string
          && userRef.display_name.size() <= 120
        ))
        && (!('profile_picture' in userRef) || (
          userRef.profile_picture is string
          && userRef.profile_picture.size() <= 500
        ));
    }

    function validSpotReport(spotId) {
      return request.auth.uid != null
        && request.resource.data.keys().hasAll([
          'spot',
          'reason',
          'user',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'spot',
          'reason',
          'duplicateOf',
          'user',
          'createdAt'
        ])
        && request.resource.data.spot is map
        && request.resource.data.spot.id == spotId
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 120
        && validModerationReportUser(request.resource.data.user)
        && request.resource.data.createdAt is timestamp;
    }

    function guestMediaReportReason(reason) {
      return reason in [
        'illegal or unsafe content',
        'copyright infringement',
        'person did not consent',
        'tos violation',
        'other'
      ];
    }

    function validMediaReport() {
      return request.resource.data.keys().hasAll([
          'media',
          'reason',
          'comment',
          'user',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'media',
          'spotId',
          'context',
          'targetId',
          'reason',
          'comment',
          'user',
          'createdAt',
          'locale',
          'kind'
        ])
        && request.resource.data.media is map
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 120
        && (request.auth != null ||
          guestMediaReportReason(request.resource.data.reason))
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000
        && (!('kind' in request.resource.data) || request.resource.data.kind == 'media')
        && validModerationReportUser(request.resource.data.user)
        && request.resource.data.createdAt is timestamp
        && (!('spotId' in request.resource.data) || request.resource.data.spotId is string)
        && (!('targetId' in request.resource.data) || request.resource.data.targetId is string)
        && (!('context' in request.resource.data) || request.resource.data.context in ['spot', 'event', 'media'])
        && (!('locale' in request.resource.data) || request.resource.data.locale is string);
    }

    function validUserReport() {
      return request.auth.uid != null
        && request.resource.data.keys().hasOnly([
          'reportedUser',
          'reason',
          'comment',
          'user',
          'createdAt',
          'sourcePath'
        ])
        && request.resource.data.keys().hasAll([
          'reportedUser',
          'reason',
          'user',
          'createdAt'
        ])
        && validReportUserReference(request.resource.data.reportedUser)
        && validModerationReportUser(request.resource.data.user)
        && request.resource.data.reportedUser.uid != request.auth.uid
        && request.resource.data.reason in [
          'harassment',
          'impersonation',
          'unsafe_profile',
          'spam_or_malicious_links',
          'other'
        ]
        && request.resource.data.createdAt is timestamp
        && (!('comment' in request.resource.data) || (
          request.resource.data.comment is string
          && request.resource.data.comment.size() <= 2000
        ))
        && (!('sourcePath' in request.resource.data) || (
          request.resource.data.sourcePath is string
          && request.resource.data.sourcePath.size() <= 500
        ));
    }

    match /spots/{spotId}
    {
      // all the spots are visible to everyone, authenticated or not
      allow read: if true;

      // TODO: In the future there should be a voting feature for changes on spots.
      // Only authenticated users can create new empty spot placeholders.
      // All actual spot data must go through the edits system.
      // The cloud function will populate the spot when processing the CREATE edit.
      // Updates are disabled - changes must go through the edits system
      allow create: if request.auth.uid != null 
        && agePolicyAllowsPublicParticipation()
        && request.resource.data.keys().size() == 0;
      allow update: if false;
      allow delete: if isAdmin();
      // allow write: if request.auth.uid != null &&
      //   (resource == null || resource.data == null ?
      //      !request.resource.data.keys().hasAny(['rating', 'num_reviews', 'rating_histogram', 'highlighted_reviews']) :
      //      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'num_reviews', 'rating_histogram', 'highlighted_reviews']))
      //      && (request.resource.data.keys().hasAny(['slug']) ? exists(/databases/$(database)/documents/spot_slugs/$(request.resource.data.slug)) : true);

      match /reviews/{userId} {
        allow read: if true;
        allow create: if request.auth.uid != null 
          && agePolicyAllowsPublicParticipation()
          && request.auth.uid == userId
          && request.auth.uid == request.resource.data.user.uid
          && !exists(/databases/$(database)/documents/spots/$(spotId)/reviews/$(userId))
          && !('comment' in request.resource.data)
          && request.resource.data.rating is int 
          && request.resource.data.rating >= 1 
          && request.resource.data.rating <= 5;
        allow update: if request.auth.uid != null
          && agePolicyAllowsPublicParticipation()
          && request.auth.uid == request.resource.data.user.uid
          && request.auth.uid == userId
          && request.resource.data.get('comment', null) ==
            resource.data.get('comment', null)
          && request.resource.data.rating is int 
          && request.resource.data.rating >= 1 
          && request.resource.data.rating <= 5;
        allow delete: if isAdmin() || (request.auth.uid != null
          && request.auth.uid == resource.data.user.uid
          && request.auth.uid == userId);
      }

      // Spot Reports
      match /reports/{reportId}
      {
        // The maintenance migration writes a public warning before it marks
        // completion. Raw reports then become private without a gap.
        allow read: if !spotReportPrivacyMigrationComplete() || isAdmin();
        allow create: if validSpotReport(spotId);
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Spot Challenges
      match /challenges/{challengeId}
      {
        allow read: if (!('release_date' in resource.data)) ||
          (resource.data.release_date <= request.time) ||
          (resource.data.user.uid == request.auth.uid);
        // Existing, owner-approved challenges stay readable. New submissions
        // remain closed until the moderated challenge workflow is introduced.
        allow create, update: if false;
        allow delete: if isAdmin();
      }

      match /edits/{editId}
      {
        allow read: if canReadSpotEdit();
        allow create: if request.auth.uid != null 
          && agePolicyAllowsPublicParticipation()
          && request.auth.uid == request.resource.data.user.uid
          && (!('target_type' in request.resource.data)
            || request.resource.data.target_type == 'spot')
          && (!('target_id' in request.resource.data)
            || request.resource.data.target_id == spotId)
          && (
            isAdmin()
            ||
            !requiresOrganizationReview(spotId)
            || request.resource.data.visibility == 'private'
          );
        allow update: if false;
        allow delete: if isAdmin();

        match /votes/{userId}
        {
          allow read: if true;
          allow create, update: if request.auth.uid != null 
            && agePolicyAllowsPublicParticipation()
            && request.auth.uid == userId
            && request.auth.uid == request.resource.data.user.uid;
          allow delete: if isAdmin();
        }
      }
    }

    match /spot_clusters/{cluster}
    {
        allow read: if true;
        allow write: if false;
    }


    match /spot_slugs/{slug} {
      allow read: if true;

      allow create: if request.auth.uid != null
        && agePolicyAllowsPublicParticipation()
        && slug.matches('^[a-z0-9-]+$')
        && !exists(/databases/$(database)/documents/spot_slugs/$(slug))
        && exists(/databases/$(database)/documents/spots/$(request.resource.data.spot_id));

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /event_slugs/{slug} {
      allow get: if isAdmin()
        || eventCanRead(
          resource.data.event_id,
          get(
            /databases/$(database)/documents/events/$(resource.data.event_id)
          ).data
        );
      allow list: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['event_id'])
        && request.resource.data.event_id is string
        && eventCanEdit(
          request.resource.data.event_id,
          get(
            /databases/$(database)/documents/events/$(request.resource.data.event_id)
          ).data
        );
      allow update: if request.resource.data.keys().hasOnly(['event_id'])
        && request.resource.data.event_id is string
        && eventCanManage(
          get(
            /databases/$(database)/documents/events/$(resource.data.event_id)
          ).data
        )
        && eventCanManage(
          get(
            /databases/$(database)/documents/events/$(request.resource.data.event_id)
          ).data
        );
      allow delete: if eventCanManage(
        get(
          /databases/$(database)/documents/events/$(resource.data.event_id)
        ).data
      );
    }

    function onlyCommunityMergeRequestChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'merge_into'
      ]);
    }

    // Materialized community landing pages and slug aliases are public read-only
    // data used by SSR and crawlers. Knowledge changes go through community
    // edits; admin clients may still request merge patches directly.
    match /community_pages/{communityKey} {
      allow read: if true;
      allow update: if isAdmin() && onlyCommunityMergeRequestChanged();
      allow create, delete: if false;

      match /private_info/{privateInfoId} {
        allow read: if request.auth.uid != null;
        allow write: if false;
      }

      match /edits/{editId} {
        allow read: if isAdmin()
          || (request.auth.uid != null && resource.data.user.uid == request.auth.uid);
        allow create: if request.auth.uid != null
          && agePolicyAllowsPublicParticipation()
          && exists(/databases/$(database)/documents/community_pages/$(communityKey))
          && validCommunityKnowledgeEdit(communityKey);
        allow update, delete: if false;
      }
    }

    match /community_slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /community_merges/{communityKey} {
      allow read: if true;
      allow write: if false;
    }

    match /community_card_suggestions/{suggestionId} {
      allow create: if request.auth.uid != null
        && agePolicyAllowsPublicParticipation()
        && request.resource.data.status == 'pending'
        && request.resource.data.created_by.uid == request.auth.uid
        && request.resource.data.community_key is string
        && request.resource.data.card is map;
      allow read, update, delete: if isAdmin();
    }

    match /posts/{post}
    {
      // every post is publicy available to everyone.
      allow read: if true;

      // only authenticated users can create and edit posts and only create and edit it if it's their post. Also, they can't set the like_count variable.
      allow create, update: if request.auth.uid != null 
        && agePolicyAllowsPublicParticipation()
        && request.auth.uid == request.resource.data.user.uid
        && !('like_count' in request.resource.data);
      allow delete: if request.auth.uid != null 
        && request.auth.uid == resource.data.user.uid;

      // match the subcollection likes
      match /likes/{userId} {
        // Only authenticated users can view who liked a post
        allow read: if request.auth.uid != null;

        // Only you can edit your like
        allow create, update: if request.auth.uid == userId
          && agePolicyAllowsPublicParticipation()
          && request.auth.uid == request.resource.data.user.uid;
        allow delete: if request.auth.uid == userId
          && request.auth.uid == resource.data.user.uid;
      }
    }
    
    match /users/{userId} 
    {
      // all users and their profiles are currently public
      allow read: if true;
      // It is not allowed to update protected fields. These are handled by cloud functions.
      allow create: if request.auth.uid != null && request.auth.uid == userId
         && !request.resource.data.keys().hasAny(['follower_count', 'following_count', 'visited_spots_count', 'spot_edits_count', 'spot_creates_count', 'media_added_count', 'signup_number', 'is_admin', 'special_badges', 'age_policy'])
         && !('home_spots' in request.resource.data)
         && validUserSocials()
         && validUserProfileAccess()
         && noUserCustomSocialLinksOnCreate();
      allow update: if request.auth.uid != null && request.auth.uid == userId
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['follower_count', 'following_count', 'visited_spots_count', 'spot_edits_count', 'spot_creates_count', 'media_added_count', 'signup_number', 'is_admin', 'special_badges', 'age_policy'])
         && homeSpotsUnchanged()
         && (
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(userPublicParticipationFields())
           || agePolicyAllowsPublicParticipation()
         )
         && validUserSocials()
         && validUserProfileAccess()
         && userCustomSocialLinksUnchanged();
      allow delete: if request.auth.uid != null && request.auth.uid == userId;

      match /following/{otherUserId} {
        // A user can only see and update his own following
        allow read: if request.auth.uid != null && request.auth.uid == userId;
        allow create, update: if request.auth.uid != null
        && (
          (
            agePolicyAllowsPublicParticipation()
            && request.auth.uid == userId
            && request.auth.uid != otherUserId
            && get(/databases/$(database)/documents/users/$(otherUserId)).data.get('account_privacy', 'public') != 'private'
          )
          || (
            request.auth.uid == otherUserId
            && canApproveFollowRequest(otherUserId, userId)
            && validApprovedFollowingEdge(otherUserId)
          )
        );
        allow delete: if request.auth.uid != null
        && request.auth.uid == userId && request.auth.uid != otherUserId;
      }
      match /followers/{otherUserId} {
        // A user can only see his own followers
        allow read: if request.auth.uid != null && request.auth.uid == userId;
        // TODO write cloud function to handle updating followers and remove this permission to write.
        allow create, update: if request.auth.uid != null
        && (
          (
            agePolicyAllowsPublicParticipation()
            && request.auth.uid == otherUserId
            && request.auth.uid != userId
            && get(/databases/$(database)/documents/users/$(userId)).data.get('account_privacy', 'public') != 'private'
          )
          || (
            request.auth.uid == userId
            && canApproveFollowRequest(userId, otherUserId)
            && validApprovedFollowerEdge(userId, otherUserId)
          )
        );
        allow delete: if request.auth.uid != null &&
        request.auth.uid == otherUserId && request.auth.uid != userId;
      }

      match /follow_requests/{requesterId} {
        allow read: if request.auth.uid != null
          && (request.auth.uid == userId || request.auth.uid == requesterId);
        allow create, update: if request.auth.uid != null
          && agePolicyAllowsPublicParticipation()
          && request.auth.uid == requesterId
          && validFollowRequest(userId, requesterId);
        allow delete: if request.auth.uid != null
          && (request.auth.uid == userId || request.auth.uid == requesterId);
      }

      match /check_ins/{checkInId} {
        // Private to the user
        allow read, create, delete: if request.auth.uid != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /community_follows/{communityKey} {
        allow read, create, update, delete: if request.auth.uid != null
          && request.auth.uid == userId;
      }

      match /session_records/{sessionRecordId} {
        allow read, delete: if request.auth.uid != null
          && request.auth.uid == userId;
        allow create, update: if request.auth.uid != null
          && request.auth.uid == userId
          && request.resource.data.owner_id == userId;
      }

      match /log_entries/{logEntryId} {
        allow get, list: if canReadLogEntry(userId, resource.data);
        allow create: if request.auth.uid != null
          && request.auth.uid == userId
          && validLogEntry(userId);
        allow update: if request.auth.uid != null
          && request.auth.uid == userId
          && request.resource.data.owner_id == resource.data.owner_id
          && request.resource.data.time_created == resource.data.time_created
          && request.resource.data.time_created_raw_ms
            == resource.data.time_created_raw_ms
          && validLogEntry(userId);
        allow delete: if request.auth.uid != null
          && request.auth.uid == userId;
      }

      match /private_data/{docId} {
        // Private to the user - stores bookmarks and visited_spots
        allow read, write: if request.auth.uid != null && request.auth.uid == userId;
      }

      match /notification_registrations/{registrationId} {
        allow read, delete: if request.auth.uid != null && request.auth.uid == userId;
        allow create, update: if request.auth.uid != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
            'token',
            'platform',
            'app_version',
            'locale',
            'permission_state',
            'enabled',
            'created_at_raw_ms',
            'last_seen_at_raw_ms'
          ])
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'app_version',
            'locale',
            'permission_state',
            'enabled',
            'disabled_reason',
            'created_at_raw_ms',
            'last_seen_at_raw_ms'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios', 'web']
          && request.resource.data.app_version is string
          && request.resource.data.locale is string
          && request.resource.data.permission_state in [
            'prompt',
            'prompt-with-rationale',
            'granted',
            'denied',
            'unsupported',
            'unknown'
          ]
          && request.resource.data.enabled is bool
          && request.resource.data.created_at_raw_ms is number
          && request.resource.data.last_seen_at_raw_ms is number
          && (
            !('disabled_reason' in request.resource.data)
            || request.resource.data.disabled_reason in [
              'permission_denied',
              'signed_out',
              'invalid_token'
            ]
          );
      }

      match /notifications/{notificationId} {
        allow read: if request.auth.uid != null && request.auth.uid == userId;
        allow update: if request.auth.uid != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read_at_raw_ms',
            'dismissed_at_raw_ms'
          ])
          && (
            !('read_at_raw_ms' in request.resource.data)
            || request.resource.data.read_at_raw_ms is number
          )
          && (
            !('dismissed_at_raw_ms' in request.resource.data)
            || request.resource.data.dismissed_at_raw_ms is number
          );
        allow create, delete: if false;
      }
    }

    match /notification_intents/{intentId} {
      allow read, write: if false;
    }

    match /organizations/{organizationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /members/{userId} {
        allow read: if request.auth.uid != null
          && (request.auth.uid == userId || isAdmin() || isOrganizationReviewer(organizationId));
        allow create, update, delete: if isAdmin();
      }

      match /verified_spots/{spotId} {
        allow read: if true;
        allow write: if false;
      }

      match /managed_spots/{spotId} {
        allow read: if true;
        allow write: if false;
      }

      match /used_spots/{spotId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /events/{eventId} {
      allow get: if eventCanRead(eventId, resource.data);
      allow list: if isAdmin() || legacyEventListCompatibilityEnabled();
      allow create: if request.auth.uid != null
        && agePolicyAllowsPublicParticipation()
        && request.resource.data.keys().hasAll(['owner', 'created_by'])
        && validEventOwner(request.resource.data.owner)
        && validEventCreator(request.resource.data.created_by)
        && validEventAuditTimestamps(request.resource.data)
        && validEventAccessDimensions(request.resource.data)
        && (
          !legacyEventListCompatibilityEnabled()
          || eventIsLegacyListCompatible(request.resource.data)
        )
        && !request.resource.data.keys().hasAny(eventComputedFields())
        && (
          isAdmin()
          || (
            eventOwnerMayBeAssignedByViewer(request.resource.data.owner)
            && eventPolicyOrganizationsManagedByViewer(request.resource.data)
            && request.resource.data.get('priority', 'normal') == 'normal'
            && !request.resource.data.keys().hasAny([
              'is_promoted',
              'is_sponsored',
              'promo_starts_at',
              'promo_region',
              'promo_radius_m'
            ])
          )
        );
      // Missing owner is the legacy/admin-managed state.
      allow update: if validEventAuditTimestamps(request.resource.data)
        && validEventAccessDimensions(request.resource.data)
        && (
          !legacyEventListCompatibilityEnabled()
          || eventIsLegacyListCompatible(request.resource.data)
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['created_by'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(eventComputedFields())
        && (
          isAdmin()
          || (
            eventCanEdit(eventId, resource.data)
            && request.resource.data.owner == resource.data.owner
            && (
              eventOrganizationPoliciesUnchanged(
                resource.data,
                request.resource.data
              )
              || eventPolicyOrganizationsManagedByViewer(request.resource.data)
            )
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              eventPlatformControlledFields()
            )
          )
        );
      allow delete: if eventCanManage(resource.data);

      match /rsvps/{userId} {
        allow read: if request.auth.uid != null
          && (
            request.auth.uid == userId
            || isAdmin()
            || isMutualFriend(userId)
          );
        allow create, update: if request.auth.uid != null
          && agePolicyAllowsPublicParticipation()
          && request.auth.uid == userId
          && eventCanRead(
            eventId,
            get(/databases/$(database)/documents/events/$(eventId)).data
          )
          && validEventRsvp(eventId, userId);
        allow delete: if request.auth.uid != null
          && (request.auth.uid == userId || isAdmin());
      }

      match /admission/{stateId} {
        allow read: if stateId == 'state'
          && eventCanRead(
            eventId,
            get(/databases/$(database)/documents/events/$(eventId)).data
          );
        allow write: if false;
      }

      match /registrations/{userId} {
        allow get: if request.auth.uid != null
          && (
            request.auth.uid == userId
            || eventCanManage(
              get(/databases/$(database)/documents/events/$(eventId)).data
            )
          );
        allow list: if eventCanManage(
          get(/databases/$(database)/documents/events/$(eventId)).data
        );
        // Capacity, waitlist order, and promotion must stay atomic.
        allow create, update, delete: if false;
      }

      match /live_updates/{updateId} {
        allow read: if eventCanRead(
          eventId,
          get(/databases/$(database)/documents/events/$(eventId)).data
        );
        // Updates are created only by publishEventLiveUpdate after its backend
        // organizer, validation, event-state, and cooldown checks pass.
        allow create, update, delete: if false;
      }

      match /live_update_subscribers/{userId} {
        // A missing preference must still be readable so the client can apply
        // an RSVP default. Collection-group lists use the stored owner field
        // as their query predicate.
        allow get: if request.auth.uid != null && request.auth.uid == userId;
        allow list: if request.auth.uid != null
          && resource.data.user_id == request.auth.uid;
        allow create: if request.auth.uid != null
          && request.auth.uid == userId
          && validEventLiveUpdateSubscription(userId)
          && (
            (request.resource.data.active == false
              && request.resource.data.get('event_reminders', false) == false)
            || eventAcceptsLiveUpdateSubscriptions(eventId)
          );
        allow update: if request.auth.uid != null
          && request.auth.uid == userId
          && validEventLiveUpdateSubscription(userId)
          && (
            (request.resource.data.active == false
              && request.resource.data.get('event_reminders', false) == false)
            || eventAcceptsLiveUpdateSubscriptions(eventId)
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'active',
            'event_reminders',
            'updated_at'
          ]);
        allow delete: if request.auth.uid != null && request.auth.uid == userId;
      }

      match /live_update_state/{stateId} {
        allow read, write: if false;
      }

      match /access/{userId} {
        allow get: if request.auth.uid != null
          && (
            request.auth.uid == userId
            || eventCanManage(
              get(/databases/$(database)/documents/events/$(eventId)).data
            )
          );
        allow list: if eventCanManage(
          get(/databases/$(database)/documents/events/$(eventId)).data
        );
        allow create: if eventCanManage(
            get(/databases/$(database)/documents/events/$(eventId)).data
          )
          && validEventAccessGrant(userId)
          && request.resource.data.granted_by == request.auth.uid;
        allow update: if eventCanManage(
            get(/databases/$(database)/documents/events/$(eventId)).data
          )
          && validEventAccessGrant(userId)
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.granted_by == resource.data.granted_by
          && request.resource.data.time_created == resource.data.time_created;
        allow delete: if eventCanManage(
          get(/databases/$(database)/documents/events/$(eventId)).data
        );
      }
    }

    match /event_discovery/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Series (Swiss Parkour Tour, SPL, Parkour Earth, ...) are admin-curated
    // and publicly readable.
    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboards are read-only; only cloud functions can write
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false;
    }

    // Safety, legal, privacy, and other serious reports may be submitted by
    // affected people without accounts. Quality reports require authentication.
    // Current clients use the callable endpoint for server-side abuse controls.
    match /media_reports/{reportId} {
      allow create: if validMediaReport();
      allow read, update, delete: if isAdmin();
    }

    // Current media reports. The root collection intentionally shares the
    // "reports" collection id with target report subcollections so the
    // moderation queue can aggregate them with a collection-group query.
    match /reports/{reportId} {
      allow create: if request.resource.data.kind == 'media'
        && validMediaReport();
      allow read, update, delete: if isAdmin();
    }

    match /user_reports/{reportId} {
      allow create: if validUserReport();
      allow read, update, delete: if isAdmin();
    }

    // Contact Messages
    // Anyone can create a message, but clients cannot read, update, or delete
    // the private inbox. Cloud Functions send Discord notifications via Admin SDK.
    match /contact_messages/{messageId} {
      allow create: if validContactMessage();
      allow read, update, delete: if isAdmin();
    }

    match /moderation_actions/{actionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /maintenance/{maintenanceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /report_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /legacy_review_texts/{archiveId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /media_upload_reviews/{reviewId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /media_upload_status/{uploadId} {
      allow read: if request.auth.uid != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /csam_incidents/{incidentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /safety_incidents/{incidentId} {
      allow read: if isAdmin();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /imports/{importId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }
    // Collection Group Queries
    match /{path=**}/reports/{reportId} {
      allow read, update, delete: if isAdmin();
    }

    match /{path=**}/edits/{editId} {
      allow read: if isAdmin();
    }
  }
}
