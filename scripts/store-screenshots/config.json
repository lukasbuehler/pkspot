  "captures": [
    {
      "id": "map",
      "dismissSelectors": ["app-map-island .event-island .island-actions button:last-child"],
      "path": "/{appLocale}/map",
      "waitForSelector": ".gm-style app-marker",
      "settleMs": 5000,
      "hideSelectors": [
        ".dev-mode-banner"
      ]
    },
    {
      "id": "spot",
      "expandSheet": true,
      "path": "/{appLocale}/map/spots/imax",
      "waitForSelector": "app-spot-details img",
      "settleMs": 5000,
      "hideSelectors": [
        ".dev-mode-banner"
      ]
    },
    {
      "id": "event",
      "path": "/{appLocale}/events/swissjam26",
      "mockEventRsvps": { "swissjam26": "interested" },
      "waitForSelector": ".event-heading h1",
      "settleMs": 5000,
      "hideSelectors": [
        ".dev-mode-banner"
      ]
    },
    {
      "id": "community",
      "expandSheet": true,
      "path": "/{appLocale}/map/communities/zuerich",
      "waitForSelector": ".community-panel-body",
      "settleMs": 5000,
      "hideSelectors": [
        ".dev-mode-banner"
      ]
    },
    {
      "id": "training",
      "path": "/{appLocale}/train/log",
      "waitForSelector": ".session-card",
      "fixture": "training",
      "scrollToSelector": "app-training-activity-contribution-graph",
      "systemUi": { "statusBackground": "#0e0e11" },
      "settleMs": 5000,
      "hideSelectors": [
        ".dev-mode-banner"
      ]
    }
  ],
  "deviceScreenshots": [
    {
      "capture": "map",
      "index": 1
    },
    {
      "capture": "spot",
      "index": 2
    },
