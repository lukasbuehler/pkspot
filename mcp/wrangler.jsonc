{
  // Cloudflare Builds uses /mcp as its repository root and watches mcp/**.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkspot-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Add the mcp.pkspot.app custom-domain route only at the approved deployment.
  "vars": {
    "FIRESTORE_PROJECT_ID": "parkour-base-project",
    "PUBLIC_ORIGIN": "https://mcp.pkspot.app",
    "TYPESENSE_ORIGIN": "https://search.pkspot.app",
    // Public proof of domain ownership, not an authentication credential.
    "OPENAI_DOMAIN_VERIFICATION_TOKEN": "PqWjQ7rGRbs8bK7QuKdSNqrjKG4wlQs1ymFlqAChGKg"
  },
  "durable_objects": {
    "bindings": [{ "name": "QUOTAS", "class_name": "QuotaStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaStore"] }],
  // Omit limits.cpu_ms: custom CPU limits require Workers Paid.
  // Workers Free applies its default 10 ms CPU limit per HTTP request.
  "observability": {
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
    // issue_detection remains dashboard-managed until Wrangler supports it.
  }
}
