{
  // Cloudflare Builds uses /mcp as its repository root and watches mcp/**.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkspot-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Add the mcp.pkspot.app custom-domain route only at the approved deployment.
  "vars": { "PUBLIC_ORIGIN": "https://mcp.pkspot.app" },
  "durable_objects": {
    "bindings": [{ "name": "QUOTAS", "class_name": "QuotaStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaStore"] }],
  // Omit limits.cpu_ms: custom CPU limits require Workers Paid.
  // Workers Free applies its default 10 ms CPU limit per HTTP request.
  // Do not capture tool arguments, raw URLs, network identifiers or responses.
  "observability": { "enabled": false }
}
