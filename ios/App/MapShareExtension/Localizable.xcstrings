{
  "sourceLanguage": "en",
  "strings": {
    "Open this location in PK Spot": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Ort in PK Spot öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir esta ubicación en PK Spot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir ce lieu dans PK Spot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri questo luogo in PK Spot"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open deze locatie in PK Spot"
          }
        }
      }
    },
    "Save the Maps link, then open PK Spot to review the location. Nothing is published.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere den Maps-Link und öffne danach PK Spot, um den Ort anzusehen. Es wird nichts veröffentlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el enlace de Maps y abre PK Spot para revisar la ubicación. No se publica nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le lien Maps, puis ouvre PK Spot pour consulter le lieu. Rien ne sera publié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il link di Maps, poi apri PK Spot per vedere il luogo. Non viene pubblicato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de Maps-link en open daarna PK Spot om de locatie te bekijken. Er wordt niets gepubliceerd."
          }
        }
      }
    },
    "No supported Google Maps or Apple Maps link was found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein unterstützter Google-Maps- oder Apple-Maps-Link gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un enlace compatible de Google Maps o Apple Maps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lien Google Maps ou Apple Maps pris en charge trouvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun link di Google Maps o Apple Maps supportato trovato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ondersteunde Google Maps- of Apple Maps-link gevonden."
          }
        }
      }
    },
    "Could not save the link. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link konnte nicht gespeichert werden. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el enlace. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le lien. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il link. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link kon niet worden opgeslagen. Probeer het opnieuw."
          }
        }
      }
    },
    "Save Maps link": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps-Link speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar enlace de Maps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer le lien Maps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva link di Maps"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps-link bewaren"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleren"
          }
        }
      }
    },
    "Spot drafts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot-Entwürfe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borradores de Spots"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillons de Spots"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozze di Spot"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot-concepten"
          }
        }
      }
    },
    "Saved on this device. Review a draft before publishing. Opening it keeps it here until you remove it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gespeichert. Prüfe einen Entwurf vor dem Veröffentlichen. Er bleibt hier, bis du ihn entfernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados en este dispositivo. Revisa cada borrador antes de publicarlo. Abrirlo no lo elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrés sur cet appareil. Vérifie un brouillon avant de le publier. Il reste ici jusqu’à sa suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvate su questo dispositivo. Controlla una bozza prima di pubblicarla. Rimane qui finché non la rimuovi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen op dit apparaat. Controleer een concept voordat je het publiceert. Het blijft hier totdat je het verwijdert."
          }
        }
      }
    },
    "View on map": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Karte ansehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver en el mapa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir sur la carte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sulla mappa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk op de kaart"
          }
        }
      }
    },
    "Create Spot": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear Spot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer un Spot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea Spot"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot maken"
          }
        }
      }
    },
    "Remove draft": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwurf entfernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar borrador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le brouillon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi bozza"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Concept verwijderen"
          }
        }
      }
    },
    "No pending drafts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine ausstehenden Entwürfe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay borradores pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun brouillon en attente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna bozza in sospeso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen openstaande concepten."
          }
        }
      }
    },
    "Could not remove the draft. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwurf konnte nicht entfernt werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar el borrador. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer le brouillon. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere la bozza. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het concept kon niet worden verwijderd. Probeer het opnieuw."
          }
        }
      }
    },
    "Save a Spot draft": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot-Entwurf speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar un borrador de Spot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer un brouillon de Spot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una bozza di Spot"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Spot-concept opslaan"
          }
        }
      }
    },
    "Review this location now and finish in PK Spot later. Nothing is published.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe diesen Ort und fahre später in PK Spot fort. Es wird nichts veröffentlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa esta ubicación y termina más tarde en PK Spot. No se publica nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ce lieu et termine plus tard dans PK Spot. Rien n’est publié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla questo luogo e completa più tardi in PK Spot. Non viene pubblicato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer deze locatie en rond later af in PK Spot. Er wordt niets gepubliceerd."
          }
        }
      }
    },
    "Finding location": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ort wird gesucht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando ubicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche du lieu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca del luogo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie zoeken"
          }
        }
      }
    },
    "Spot name (optional)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot-Name (optional)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre del Spot (opcional)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom du Spot (facultatif)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome dello Spot (facoltativo)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot-naam (optioneel)"
          }
        }
      }
    },
    "This link does not reveal an exact pin location. You can keep it as a draft and choose the location in PK Spot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link enthält keine genaue Position. Speichere ihn als Entwurf und wähle den Ort in PK Spot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace no contiene una ubicación exacta. Puedes guardarlo como borrador y elegir la ubicación en PK Spot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien ne contient pas de position précise. Tu peux le garder comme brouillon et choisir le lieu dans PK Spot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link non contiene una posizione precisa. Puoi salvarlo come bozza e scegliere il luogo in PK Spot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link bevat geen exacte locatie. Je kunt hem als concept bewaren en de locatie in PK Spot kiezen."
          }
        }
      }
    },
    "Nearby Spots could not be loaded. You can still save a draft.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spots in der Nähe konnten nicht geladen werden. Du kannst trotzdem einen Entwurf speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los Spots cercanos. Aún puedes guardar un borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les Spots à proximité. Tu peux quand même enregistrer un brouillon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare gli Spot vicini. Puoi comunque salvare una bozza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spots in de buurt konden niet worden geladen. Je kunt wel een concept opslaan."
          }
        }
      }
    },
    "No nearby Spots found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spots in der Nähe gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron Spots cercanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun Spot trouvé à proximité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno Spot trovato nelle vicinanze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Spots in de buurt gevonden."
          }
        }
      }
    },
