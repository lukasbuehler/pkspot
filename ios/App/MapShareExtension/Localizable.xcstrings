    },
    "Choose a match only if it is the same Spot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Treffer nur, wenn es derselbe Spot ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un resultado solo si es el mismo Spot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un résultat uniquement s’il s’agit du même Spot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un risultato solo se si tratta dello stesso Spot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies alleen een resultaat als het dezelfde Spot is."
          }
        }
      }
    },
    "Could not load or save this Maps link. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Maps-Link konnte nicht geladen oder gespeichert werden. Versuche es erneut."
          }
        },
