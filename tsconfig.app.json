{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    // Keep type-check results out of the shared .angular/cache/.tsbuildinfo.
    // `ng serve`, `ng build` and every git worktree read and write that one
    // file, so a long-running dev server could save a false error that later
    // builds would report until the cache was cleared.
    "incremental": false,
    "types": ["node", "@angular/localize"]
  },
  "files": [
    "src/main.ts",
    "src/main.dev.ts",
    "src/main.server.ts",
    "src/main.cloudflare.ts",
    "server.ts",
    "server.cloudflare.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
